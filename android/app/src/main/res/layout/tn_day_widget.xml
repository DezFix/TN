<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tn_widget_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/dw_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/dw_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_dw_check_on"
            android:contentDescription="task widget" />

        <TextView
            android:id="@+id/dw_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/dw_title_tasks"
            android:textColor="#2AABEE"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/dw_settings"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_menu_manage"
            android:contentDescription="widget settings"
            android:tint="#8A9BA8" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dw_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/dw_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/dw_empty"
        android:textColor="#8A9BA8"
        android:textSize="13sp" />

</LinearLayout>
