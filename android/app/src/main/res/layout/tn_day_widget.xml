<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tn_widget_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <!-- Header pill: accent icon, title, task-count badge, gear. -->
    <LinearLayout
        android:id="@+id/dw_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/dw_header_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/dw_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_dw_check_on"
            android:contentDescription="task widget" />

        <TextView
            android:id="@+id/dw_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/dw_title_tasks"
            android:textColor="#4EA4F6"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dw_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="20dp"
            android:gravity="center"
            android:background="@drawable/dw_count_bg"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/dw_hot_add"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_dw_add"
            android:contentDescription="quick add" />

        <ImageView
            android:id="@+id/dw_settings"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_dw_gear"
            android:contentDescription="widget settings" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/dw_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp" />

        <TextView
            android:id="@+id/dw_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/dw_empty"
            android:textColor="#8A9BA8"
            android:textSize="13sp" />
    </FrameLayout>

</LinearLayout>
