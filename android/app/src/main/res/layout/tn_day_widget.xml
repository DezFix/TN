<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tn_widget_bg"
    android:orientation="vertical"
    android:paddingTop="0dp"
    android:paddingBottom="8dp">

    <!-- Header attached to window (no floating pill), + and gear separated. -->
    <LinearLayout
        android:id="@+id/dw_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/dw_header_bg_top"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/dw_header_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/dw_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_dw_check_on"
                android:contentDescription="task widget" />

            <TextView
                android:id="@+id/dw_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/dw_title_tasks"
                android:textColor="#4EA4F6"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dw_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="22dp"
                android:gravity="center"
                android:background="@drawable/dw_count_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/dw_settings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:padding="8dp"
            android:src="@drawable/ic_dw_gear"
            android:contentDescription="widget settings" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ListView
            android:id="@+id/dw_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp" />

        <TextView
            android:id="@+id/dw_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/dw_empty"
            android:textColor="#8A9BA8"
            android:textSize="13sp" />
    </FrameLayout>

</LinearLayout>
