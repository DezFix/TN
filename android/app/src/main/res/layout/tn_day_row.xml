<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dr_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/dw_row_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="9dp"
    android:paddingEnd="10dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <ImageView
        android:id="@+id/dr_check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_dw_check_off"
        android:contentDescription="toggle done" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dr_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/dr_subs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#B8C5D0"
            android:textSize="10sp"
            android:visibility="gone"
            android:paddingTop="1dp" />

        <TextView
            android:id="@+id/dr_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#8A9BA8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Red dot for overdue tasks -->
    <ImageView
        android:id="@+id/dr_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/ic_dw_dot"
        android:contentDescription="overdue" />
</LinearLayout>
