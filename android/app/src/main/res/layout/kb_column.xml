<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kb_column_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginEnd="3dp"
    android:layout_weight="1"
    android:background="@drawable/kb_column_bg"
    android:clickable="true"
    android:focusable="false"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/kb_column_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#B8C5D0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/kb_column_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="#8A9BA8"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/kb_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:textColor="#4EA4F6"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/kb_cards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/kb_column_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#657684"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/kb_column_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:textColor="#8A9BA8"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
