<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kb_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tn_widget_bg"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/kb_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dw_header_bg_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="6dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/kb_header_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/kb_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/kb_widget_desc"
                android:src="@drawable/ic_kb_board" />

            <TextView
                android:id="@+id/kb_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/kb_title"
                android:textColor="#4EA4F6"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/kb_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/dw_count_bg"
                android:gravity="center"
                android:minWidth="24dp"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/kb_settings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/kb_settings_desc"
            android:padding="8dp"
            android:src="@drawable/ic_dw_gear" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/kb_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:id="@+id/kb_columns"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/kb_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/kb_empty"
            android:textColor="#8A9BA8"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
